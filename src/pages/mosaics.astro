---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Mosaics | The Thank You Co."
			description="Glass mosaics, candle plates, process photographs, and past work from The Thank You Co."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="collection-hero">
				<div class="shell hero-grid">
					<div>
						<p class="eyebrow">FROM THE WORKTABLE / 02</p>
						<h1>Mosaics</h1>

						<p class="intro">
							Little pieces of glass, a little patience, and the lovely uncertainty
							of seeing where everything eventually lands.
						</p>

						<a class="back-link" href="/#studio">← back to the studio</a>
					</div>

					<img
						src="/images/mosaics.png"
						alt="Handmade mosaic pieces from The Thank You Co."
					/>
				</div>
			</section>

			<section class="story">
				<div class="shell story-grid">
					<div>
						<p class="label">PIECE BY PIECE</p>
						<h2>Letting the glass decide a little.</h2>
					</div>

					<div class="body-copy">
						<p>
							I love mosaics because they can begin with a loose idea and become
							something completely different once the colors, shapes, and glass
							start meeting each other.
						</p>

						<p>
							This is where finished candle plates, experiments, works in progress,
							and all the oddly satisfying little stages in between will live.
						</p>
					</div>
				</div>
			</section>

			<section class="archive">
				<div class="shell">
					<p class="label">FROM THE ARCHIVE</p>
					<h2>Where the pieces landed.</h2>

					<div class="mosaic-gallery">
						<img src="/images/mosaics.png" alt="Finished handmade mosaic pieces." />
						<img src="/images/glass-mosaics.png" alt="Close-up of colorful glass mosaic tiles." />
						<img src="/images/mosaic_greenery.jpeg" alt="Glass mosaic pieces styled with greenery." />
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #f5f0e6;
		color: #353629;
		font-family: 'Montserrat', sans-serif;
	}

	.shell {
		width: min(1180px, calc(100% - 42px));
		margin: 0 auto;
	}

	.collection-hero {
		padding: 110px 0;
		background: #fbf8f1;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: .9fr 1.1fr;
		gap: 80px;
		align-items: center;
	}

	.hero-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.eyebrow,
	.label {
		font-size: .7rem;
		font-weight: 600;
		letter-spacing: .22em;
		text-transform: uppercase;
		color: #77775a;
	}

	h1,
	h2 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		color: #55523a;
		font-weight: 500;
	}

	h1 {
		margin: 12px 0 24px;
		font-size: clamp(4rem, 8vw, 7rem);
		line-height: .9;
		font-style: italic;
	}

	h2 {
		margin: 10px 0 0;
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: .95;
	}

	.intro {
		max-width: 560px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.4rem;
		line-height: 1.55;
		color: rgba(53,54,41,.74);
	}

	.back-link {
		display: inline-block;
		margin-top: 24px;
		text-decoration: none;
		color: #b97858;
		font-size: .72rem;
		letter-spacing: .15em;
		text-transform: uppercase;
	}

	.story,
	.archive {
		padding: 100px 0;
	}

	.story-grid {
		display: grid;
		grid-template-columns: .8fr 1.2fr;
		gap: 80px;
	}

	.body-copy {
		max-width: 650px;
		line-height: 1.8;
		color: rgba(53,54,41,.72);
	}

	.archive {
		background: #fbf8f1;
	}

	.mosaic-gallery {
		display: grid;
		grid-template-columns: 1.1fr .9fr .9fr;
		gap: 18px;
		margin-top: 45px;
	}

	.mosaic-gallery img {
		width: 100%;
		height: 420px;
		object-fit: cover;
	}

	@media (max-width: 800px) {
		.hero-grid,
		.story-grid,
		.mosaic-gallery {
			grid-template-columns: 1fr;
		}

		.mosaic-gallery img {
			height: auto;
			aspect-ratio: 4 / 3;
		}
	}
</style>
