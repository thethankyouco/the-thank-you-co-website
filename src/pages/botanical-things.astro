---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Botanical Things | The Thank You Co."
			description="Plant propagations, botanical experiments, and plant-inspired work from The Thank You Co."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="collection-hero">
				<div class="shell hero-grid">
					<div>
						<p class="eyebrow">FROM THE WORKTABLE / 03</p>
						<h1>Botanical things</h1>

						<p class="intro">
							Rooted cuttings, little glass vessels, unruly leaves, and the
							ever-growing collection of green things taking over the studio.
						</p>

						<a class="back-link" href="/#studio">← back to the studio</a>
					</div>

					<img
						src="/images/propies.png"
						alt="Plant propagations from The Thank You Co."
					/>
				</div>
			</section>

			<section class="story">
				<div class="shell story-grid">
					<div>
						<p class="label">ON THE PLANT SHELF</p>
						<h2>Things taking root.</h2>
					</div>

					<div class="body-copy">
						<p>
							Some projects begin with paper or glass. Others begin with a cutting
							sitting in water and the tiny thrill of spotting the first new root.
						</p>

						<p>
							This page is for propagations, plant experiments, little vessels,
							botanical gifts, and all the green things that become part of the studio.
						</p>
					</div>
				</div>
			</section>

			<section class="archive">
				<div class="shell">
					<p class="label">FROM THE PLANT SHELF</p>
					<h2>A few green things.</h2>

					<div class="plant-gallery">
						<img
							src="/images/propies.png"
							alt="Plant propagations rooting in glass vessels."
						/>

						<div class="plant-note">
							<p>
								more cuttings, roots, leaves + little experiments<br />
								coming soon ♡
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background: #f5f0e6;
		color: #353629;
		font-family: 'Montserrat', sans-serif;
	}

	.shell {
		width: min(1180px, calc(100% - 42px));
		margin: 0 auto;
	}

	.collection-hero {
		padding: 110px 0;
		background: #fbf8f1;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: .9fr 1.1fr;
		gap: 80px;
		align-items: center;
	}

	.hero-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.eyebrow,
	.label {
		font-size: .7rem;
		font-weight: 600;
		letter-spacing: .22em;
		text-transform: uppercase;
		color: #77775a;
	}

	h1,
	h2 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		color: #55523a;
		font-weight: 500;
	}

	h1 {
		margin: 12px 0 24px;
		font-size: clamp(4rem, 8vw, 7rem);
		line-height: .9;
		font-style: italic;
	}

	h2 {
		margin: 10px 0 0;
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: .95;
	}

	.intro {
		max-width: 560px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.4rem;
		line-height: 1.55;
		color: rgba(53,54,41,.74);
	}

	.back-link {
		display: inline-block;
		margin-top: 24px;
		text-decoration: none;
		color: #b97858;
		font-size: .72rem;
		letter-spacing: .15em;
		text-transform: uppercase;
	}

	.story,
	.archive {
		padding: 100px 0;
	}

	.story-grid {
		display: grid;
		grid-template-columns: .8fr 1.2fr;
		gap: 80px;
	}

	.body-copy {
		max-width: 650px;
		line-height: 1.8;
		color: rgba(53,54,41,.72);
	}

	.archive {
		background: #fbf8f1;
	}

	.plant-gallery {
		display: grid;
		grid-template-columns: 1.15fr .85fr;
		gap: 30px;
		margin-top: 45px;
	}

	.plant-gallery img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.plant-note {
		display: grid;
		place-items: center;
		padding: 40px;
		text-align: center;
		border: 1px solid rgba(85,82,58,.18);
	}

	.plant-note p {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.35rem;
		color: #b97858;
	}

	@media (max-width: 800px) {
		.hero-grid,
		.story-grid,
		.plant-gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
