---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/studio-hero.jpg"
					alt="A warm handmade studio table with plants, flowers, cards, mosaic pieces, scissors and craft supplies."
				/>
				<div class="hero-wash" aria-hidden="true"></div>

				<div class="hero-content">
					<p class="eyebrow">THE THANK YOU CO.</p>
					<h1 id="hero-title">a little studio<br />of handmade things</h1>
					<p class="hero-copy">
						Paper, plants, mosaics, and small-batch pieces made slowly,
						thoughtfully, and with a soft spot for the little details.
					</p>
					<a class="quiet-link" href="#studio">wander through the studio <span>→</span></a>
				</div>
			</section>

			<section class="intro section" id="about">
				<div class="shell intro-grid">
					<div class="intro-mark">
						<img
							src="/images/the-thank-you-co-logo.jpg"
							alt="The Thank You Co. — a little studio of handmade things"
						/>
					</div>

					<div class="intro-copy">
						<p class="section-label">A LITTLE ABOUT THE STUDIO</p>
						<h2>Things made to be kept, gifted, used, and loved.</h2>
						<p>
							The Thank You Co. is a small creative studio for handmade things:
							paper goods, mosaics, botanical pieces, seasonal curiosities, and
							whatever else happens to find its way onto the worktable.
						</p>
						<p>
							Everything is made in small batches with a little nostalgia, a little
							imperfection, and a lot of attention to the details that make something
							feel personal.
						</p>
						<p class="script-note">made slowly. given lovingly.</p>
					</div>
				</div>
			</section>

			<section class="studio section" id="studio">
				<div class="shell">
					<div class="section-heading">
						<div>
							<p class="section-label">FROM THE WORKTABLE</p>
							<h2>What lives here.</h2>
						</div>
						<p class="section-sidecopy">
							A rotating collection of useful things, sentimental things,
							plantish things, and little experiments that simply felt worth making.
						</p>
					</div>

					<div class="category-grid">
						<article class="category">
							<div class="category-image paper-goods" aria-hidden="true">
								<div class="paper-card card-one">thank you</div>
								<div class="paper-card card-two"></div>
								<div class="paper-card card-three"></div>
								<span class="tiny-daisy">✿</span>
							</div>
							<div class="category-copy">
								<p class="number">01</p>
								<h3>Paper goods</h3>
								<p>
									Handmade notes, seed paper, small stationery runs, and pieces
									meant to feel good in your hand.
								</p>
							</div>
						</article>

						<article class="category">
							<div class="category-image mosaic-goods" aria-hidden="true">
								<div class="mosaic-grid">
									<span></span><span></span><span></span><span></span>
									<span></span><span></span><span></span><span></span>
									<span></span><span></span><span></span><span></span>
									<span></span><span></span><span></span><span></span>
								</div>
							</div>
							<div class="category-copy">
								<p class="number">02</p>
								<h3>Mosaics</h3>
								<p>
									Small decorative pieces, coasters, trays, and colorful
									objects with an intentionally handmade rhythm.
								</p>
							</div>
						</article>

						<article class="category">
							<div class="category-image botanical-goods" aria-hidden="true">
								<div class="stem"></div>
								<span class="leaf l1"></span>
								<span class="leaf l2"></span>
								<span class="leaf l3"></span>
								<span class="leaf l4"></span>
								<span class="flower">✿</span>
							</div>
							<div class="category-copy">
								<p class="number">03</p>
								<h3>Botanical things</h3>
								<p>
									Propagations, plant-inspired gifts, natural textures,
									and little green things for quiet corners.
								</p>
							</div>
						</article>
					</div>
				</div>
			</section>

			<section class="maker section">
				<div class="shell maker-grid">
					<div class="maker-photo-wrap">
						<img
							class="maker-photo"
							src="/images/about-grace.PNG"
							alt="Portrait of Grace, maker behind The Thank You Co."
						/>
						<div class="maker-caption">the hands, heart, and slightly overactive imagination behind The Thank You Co.</div>
					</div>

					<div class="maker-copy">
						<p class="section-label">BEHIND THE STUDIO</p>
						<h2>Hello, I’m Grace.</h2>
						<p>
							By day, I work in data science, but I’ve always needed a creative corner of my life — somewhere for paper scraps, plants, mosaics, handwritten notes, old-fashioned details, and whatever little idea I can’t stop thinking about.
						</p>
						<p>
							The Thank You Co. grew out of that love for making things that feel personal. Not perfect. Not mass-produced. Just thoughtful, useful, beautiful little things made slowly and with a lot of care.
						</p>
						<p>
							You’ll find a bit of everything here as the studio grows: handmade cards, paper goods, plant-inspired pieces, mosaics, seasonal creations, and probably a few experiments along the way. I like to think of it less as a traditional shop and more as my little studio — a place where I can make something simply because it delighted me, and hopefully pass a little of that delight on to you.
						</p>
						<p>
							I’m so glad you found your way here.
						</p>
						<p>
							- Grace
						</p>
						<div class="mini-rule"></div>
						<p class="soft-note">
							There will probably be flowers on the table. There will almost certainly
							be a cat nearby.
						</p>
					</div>
				</div>
			</section>

			<section class="shop section" id="shop">
				<div class="shell shop-grid">
					<div class="shop-copy">
						<p class="section-label">SHOP THE STUDIO</p>
						<h2>See what’s on the worktable.</h2>
						<p>
							The shop changes as the studio does. Some pieces come back,
							some exist only once, and some are simply experiments that became favorites.
						</p>
						<!-- Replace # with your Etsy shop URL -->
						<a class="shop-link" href="#">VISIT THE SHOP <span>↗</span></a>
					</div>

					<div class="shop-note-card">
						<p class="smallcaps">SMALL BATCHES</p>
						<p class="shop-script">made with care,<br />never rushed.</p>
						<p class="heart-row">♡ &nbsp; ✿ &nbsp; ♡</p>
					</div>
				</div>
			</section>

			<section class="closing">
				<div class="shell closing-inner">
					<p class="closing-kicker">THE THANK YOU CO.</p>
					<h2>a little studio of handmade things</h2>
					<p class="closing-note">thank you for stopping by ♡</p>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--ivory: #f5f0e6;
		--paper: #fbf8f1;
		--sage: #77775a;
		--olive: #55523a;
		--soft-green: #9a9b78;
		--blush: #d6ad9c;
		--terracotta: #b97858;
		--sand: #cdb99b;
		--ink: #353629;
		--line: rgba(85, 82, 58, 0.18);
		--shell: min(1180px, calc(100% - 42px));
	}

	* { box-sizing: border-box; }

	html {
		scroll-behavior: smooth;
		background: var(--ivory);
	}

	body {
		margin: 0;
		background: var(--ivory);
		color: var(--ink);
		font-family: 'Montserrat', sans-serif;
		font-size: 16px;
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}

	::selection {
		background: #ddd1bd;
		color: var(--ink);
	}

	.shell {
		width: var(--shell);
		margin: 0 auto;
	}

	.section {
		padding: 110px 0;
	}

	.section-label,
	.eyebrow,
	.smallcaps,
	.closing-kicker {
		margin: 0 0 18px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--olive);
	}

	h1, h2, h3 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.hero {
		position: relative;
		min-height: 760px;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-wash {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(247,243,234,.82) 0%, rgba(247,243,234,.54) 42%, rgba(247,243,234,.24) 100%),
			linear-gradient(180deg, rgba(255,255,255,.08), rgba(245,240,230,.28));
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: var(--shell);
		margin: 0 auto;
		padding: 80px 0;
	}

	.hero-content > * {
		max-width: 720px;
	}

	.hero h1 {
		font-size: clamp(4.8rem, 8.7vw, 8.6rem);
		line-height: 0.86;
		margin: 0;
		color: var(--olive);
		font-style: italic;
		font-weight: 400;
	}

	.hero-copy {
		margin: 30px 0 0;
		max-width: 590px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.45rem;
		line-height: 1.55;
		color: rgba(53,54,41,.78);
	}

	.quiet-link {
		display: inline-flex;
		gap: 12px;
		align-items: center;
		margin-top: 34px;
		text-decoration: none;
		font-size: .73rem;
		font-weight: 600;
		letter-spacing: .18em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--olive);
		padding-bottom: 6px;
	}

	.quiet-link span {
		font-size: 1rem;
		transition: transform .2s ease;
	}

	.quiet-link:hover span {
		transform: translateX(4px);
	}

	.intro {
		background: var(--paper);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: .85fr 1.15fr;
		gap: 90px;
		align-items: center;
	}

	.intro-mark {
		max-width: 480px;
		justify-self: center;
	}

	.intro-mark img {
		width: 100%;
		border-radius: 50%;
		box-shadow: 0 24px 70px rgba(82,72,48,.08);
	}

	.intro-copy h2,
	.section-heading h2,
	.maker-copy h2,
	.shop-copy h2 {
		margin: 0 0 24px;
		font-size: clamp(3.3rem, 5.6vw, 5.6rem);
		line-height: .95;
		color: var(--olive);
	}

	.intro-copy p:not(.section-label):not(.script-note),
	.maker-copy p:not(.section-label):not(.soft-note),
	.shop-copy p:not(.section-label) {
		color: rgba(53,54,41,.72);
		max-width: 690px;
	}

	.script-note {
		margin: 34px 0 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.8rem;
		color: var(--terracotta);
	}

	.studio {
		background: var(--ivory);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr .7fr;
		gap: 70px;
		align-items: end;
		margin-bottom: 54px;
	}

	.section-sidecopy {
		color: rgba(53,54,41,.65);
		max-width: 450px;
		margin: 0 0 7px;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.category {
		border-top: 1px solid var(--olive);
		padding-top: 16px;
	}

	.category-image {
		height: 360px;
		position: relative;
		overflow: hidden;
		background: #eee5d8;
	}

	.category-copy {
		padding-top: 20px;
	}

	.category-copy .number {
		margin: 0 0 6px;
		font-size: .68rem;
		letter-spacing: .16em;
		color: var(--sage);
	}

	.category-copy h3 {
		margin: 0;
		font-size: 2.45rem;
		color: var(--olive);
	}

	.category-copy p:last-child {
		color: rgba(53,54,41,.68);
		margin-bottom: 0;
	}

	.paper-goods {
		background: #e8ddcb;
		display: grid;
		place-items: center;
	}

	.paper-card {
		position: absolute;
		width: 62%;
		height: 48%;
		border: 1px solid rgba(85,82,58,.34);
		background: #f8f3ea;
		box-shadow: 9px 10px 25px rgba(82,72,48,.08);
	}

	.card-one {
		z-index: 3;
		display: grid;
		place-items: center;
		transform: rotate(-2deg);
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 2.3rem;
		font-style: italic;
		color: var(--olive);
	}

	.card-two {
		transform: rotate(6deg) translate(18px, -6px);
		background: #d8b7a7;
	}

	.card-three {
		transform: rotate(-8deg) translate(-18px, 7px);
		background: #c9c8a8;
	}

	.tiny-daisy {
		position: absolute;
		right: 14%;
		bottom: 12%;
		z-index: 5;
		color: #a27645;
		font-size: 2.3rem;
	}

	.mosaic-goods {
		background: #d4c9ae;
		display: grid;
		place-items: center;
	}

	.mosaic-grid {
		display: grid;
		grid-template-columns: repeat(4, 52px);
		gap: 8px;
		transform: rotate(-2deg);
	}

	.mosaic-grid span {
		aspect-ratio: 1;
		border: 3px solid #efe8dc;
		border-radius: 5px;
	}

	.mosaic-grid span:nth-child(4n+1) { background: #b77b5d; }
	.mosaic-grid span:nth-child(4n+2) { background: #879073; }
	.mosaic-grid span:nth-child(4n+3) { background: #d0a999; }
	.mosaic-grid span:nth-child(4n+4) { background: #b6a178; }

	.botanical-goods {
		background: #dedcc8;
	}

	.stem {
		position: absolute;
		width: 5px;
		height: 210px;
		left: 50%;
		top: 90px;
		background: var(--olive);
		transform: translateX(-50%) rotate(16deg);
		border-radius: 5px;
	}

	.leaf {
		position: absolute;
		width: 80px;
		height: 38px;
		background: #8d9274;
		border: 2px solid var(--olive);
		border-radius: 80px 8px 80px 8px;
	}

	.l1 { left: 37%; top: 145px; transform: rotate(22deg); }
	.l2 { left: 51%; top: 180px; transform: rotate(158deg); }
	.l3 { left: 32%; top: 230px; transform: rotate(12deg); }
	.l4 { left: 49%; top: 265px; transform: rotate(164deg); }

	.flower {
		position: absolute;
		left: 45%;
		top: 53px;
		font-size: 5.7rem;
		color: #b88f55;
		line-height: 1;
		transform: translateX(-50%);
	}

	.maker {
		background: var(--paper);
	}

	.maker-grid {
		display: grid;
		grid-template-columns: .82fr 1.18fr;
		gap: 90px;
		align-items: center;
	}

	.maker-photo-wrap {
		position: relative;
		max-width: 480px;
	}

	.maker-photo {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
		filter: saturate(.82) contrast(.96);
	}

	.maker-caption {
		position: absolute;
		right: -32px;
		bottom: 30px;
		background: var(--ivory);
		border: 1px solid var(--line);
		padding: 11px 18px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.15rem;
		color: var(--olive);
	}

	.mini-rule {
		width: 62px;
		height: 1px;
		background: var(--sage);
		margin: 34px 0 24px;
	}

	.soft-note {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.35rem;
		line-height: 1.45;
		color: var(--terracotta);
		max-width: 520px;
	}

	.shop {
		background: #e2d9c8;
	}

	.shop-grid {
		display: grid;
		grid-template-columns: 1.2fr .8fr;
		gap: 90px;
		align-items: center;
	}

	.shop-link {
		display: inline-flex;
		gap: 12px;
		align-items: center;
		margin-top: 18px;
		font-size: .76rem;
		font-weight: 600;
		letter-spacing: .19em;
		text-decoration: none;
		border-bottom: 1px solid var(--olive);
		padding-bottom: 7px;
	}

	.shop-note-card {
		border: 1px solid rgba(85,82,58,.38);
		padding: 58px 48px;
		text-align: center;
		background: rgba(251,248,241,.35);
	}

	.shop-script {
		margin: 12px 0 18px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 3rem;
		line-height: .95;
		color: var(--olive);
	}

	.heart-row {
		color: var(--terracotta);
		letter-spacing: .18em;
	}

	.closing {
		padding: 110px 0 120px;
		background: var(--ivory);
		text-align: center;
		border-top: 1px solid var(--line);
	}

	.closing-inner {
		max-width: 820px;
	}

	.closing h2 {
		margin: 0;
		font-size: clamp(3.8rem, 7vw, 7rem);
		line-height: .88;
		font-weight: 400;
		font-style: italic;
		color: var(--olive);
	}

	.closing-note {
		margin: 26px 0 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.2rem;
		color: var(--terracotta);
	}

	@media (max-width: 900px) {
		.hero {
			min-height: 650px;
		}

		.intro-grid,
		.maker-grid,
		.shop-grid,
		.section-heading {
			grid-template-columns: 1fr;
			gap: 50px;
		}

		.intro-mark {
			max-width: 390px;
		}

		.category-grid {
			grid-template-columns: 1fr;
			gap: 54px;
		}

		.category-image {
			height: 420px;
		}

		.maker-photo-wrap {
			margin: 0 auto;
		}

		.maker-caption {
			right: 12px;
		}
	}

	@media (max-width: 640px) {
		:root {
			--shell: min(100% - 28px, 1180px);
		}

		.section {
			padding: 78px 0;
		}

		.hero {
			min-height: 610px;
			align-items: end;
		}

		.hero-wash {
			background:
				linear-gradient(0deg, rgba(247,243,234,.92) 0%, rgba(247,243,234,.76) 47%, rgba(247,243,234,.26) 100%);
		}

		.hero-content {
			padding: 70px 0 64px;
		}

		.hero h1 {
			font-size: clamp(4rem, 16vw, 5.5rem);
		}

		.hero-copy {
			font-size: 1.25rem;
		}

		.category-image {
			height: 340px;
		}

		.maker-caption {
			position: static;
			margin-top: 10px;
			text-align: center;
		}

		.shop-note-card {
			padding: 44px 24px;
		}
	}
</style>
