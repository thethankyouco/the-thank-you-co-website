---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/mosaic_greenery.jpeg"
					alt="Colorful glass mosaic pieces surrounded by lush greenery."
				/>

				<div class="hero-content">
					<p class="eyebrow">THE THANK YOU CO.</p>

					<h1 id="hero-title">
						a little studio<br />
						of handmade things
					</h1>

					<p class="hero-copy">
						Paper, plants, mosaics, and small-batch pieces made slowly,
						thoughtfully, and with a soft spot for the little details.
					</p>

					<a class="quiet-link" href="#studio">
						wander through the studio <span>→</span>
					</a>
				</div>
			</section>

			<!-- ABOUT -->
			<section class="intro section" id="about">
				<div class="shell intro-simple">
					<div class="intro-copy">
						<p class="section-label">A LITTLE ABOUT THE STUDIO</p>

						<h2>Things made to be kept, gifted, used, and loved.</h2>

						<p>
							The Thank You Co. is a small creative studio for handmade things:
							paper goods, mosaics, botanical pieces, seasonal curiosities, and
							whatever else happens to find its way onto the worktable.
						</p>

						<p>
							Everything is made in small batches with a little nostalgia, a little
							imperfection, and a lot of attention to the details that make something
							feel personal.
						</p>

						<p class="script-note">
							made slowly. given lovingly.
						</p>
					</div>
				</div>
			</section>

			<!-- FROM THE WORKTABLE -->
			<section class="studio section" id="studio">
				<div class="shell">
					<div class="section-heading">
						<div>
							<p class="section-label">FROM THE WORKTABLE</p>
							<h2>What lives here.</h2>
						</div>

						<p class="section-sidecopy">
							A rotating collection of useful things, sentimental things,
							plantish things, and little experiments that simply felt worth making.
						</p>
					</div>

					<div class="category-grid">

						<!-- PAPER GOODS -->
						<a class="category" href="/paper-goods">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/papers.png"
									alt="Stacks of handmade botanical paper tied with twine."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">01</p>

								<h3>Paper goods</h3>

								<p>
									Handmade plantable thank-you card sets, botanical seed paper,
									and paper goods meant to feel as lovely in your hand as they do to give.
								</p>

								<span class="category-link">
									follow the paper trail <span>→</span>
								</span>
							</div>
						</a>

						<!-- MOSAICS -->
						<a class="category" href="/mosaics">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/mosaics.png"
									alt="Colorful handmade mosaic trays arranged in a warm studio setting."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">02</p>

								<h3>Mosaics</h3>

								<p>
									Small decorative pieces, candle dishes, trays, and colorful
									objects with an intentionally handmade rhythm.
								</p>

								<span class="category-link">
									see where the pieces landed <span>→</span>
								</span>
							</div>
						</a>

						<!-- BOTANICAL THINGS -->
						<a class="category" href="/botanical-things">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/propies.png"
									alt="Plant propagations rooting in clear glass vessels."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">03</p>

								<h3>Botanical things</h3>

								<p>
									Propagations, plant-inspired gifts, natural textures,
									and little green things for quiet corners.
								</p>

								<span class="category-link">
									peek at the plant shelf <span>→</span>
								</span>
							</div>
						</a>
					</div>
				</div>
			</section>

			<!-- ABOUT GRACE -->
			<section class="maker section">
				<div class="shell maker-grid">
					<div class="maker-photo-wrap">
						<img
							class="maker-photo"
							src="/images/about-grace.PNG"
							alt="Portrait of Grace, maker behind The Thank You Co."
							loading="lazy"
						/>
					</div>

					<div class="maker-copy">
						<p class="section-label">BEHIND THE STUDIO</p>

						<h2>Hello, I’m Grace.</h2>

						<p>
							By day, I work in data science, but I’ve always needed a creative
							corner of my life — somewhere for paper scraps, plants, mosaics,
							handwritten notes, old-fashioned details, and whatever little idea
							I can’t stop thinking about.
						</p>

						<p>
							The Thank You Co. grew out of that love for making things that feel
							personal. Not perfect. Not mass-produced. Just thoughtful, useful,
							beautiful little things made slowly and with a lot of care.
						</p>

						<p>
							You’ll find a bit of everything here as the studio grows: handmade
							cards, paper goods, plant-inspired pieces, mosaics, seasonal creations,
							and probably a few experiments along the way.
						</p>

						<p>
							I’m so glad you found your way here.
						</p>

						<p class="grace-signature">— Grace</p>

						<div class="mini-rule"></div>

						<p class="soft-note">
							There will probably be flowers on the table. There will almost certainly
							be a cat nearby.
						</p>
					</div>
				</div>
			</section>

			<!-- CLOSING -->
			<section class="closing">
				<div class="shell closing-inner">

					<div class="closing-pill">
						<p>thank you for stopping by ♡</p>
					</div>

					<img
						class="closing-logo"
						src="/images/the-thank-you-co-logo.jpg"
						alt="The Thank You Co."
						loading="lazy"
					/>

				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--ivory: #f5f0e6;
		--paper: #fbf8f1;
		--sage: #77775a;
		--olive: #55523a;
		--soft-green: #9a9b78;
		--blush: #d6ad9c;
		--terracotta: #b97858;
		--sand: #cdb99b;
		--ink: #353629;
		--line: rgba(85, 82, 58, 0.18);
		--shell: min(1180px, calc(100% - 42px));
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--ivory);
	}

	body {
		margin: 0;
		background: var(--ivory);
		color: var(--ink);
		font-family: 'Montserrat', sans-serif;
		font-size: 16px;
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}

	::selection {
		background: #ddd1bd;
		color: var(--ink);
	}

	.shell {
		width: var(--shell);
		margin: 0 auto;
	}

	.section {
		padding: 110px 0;
	}

	.section-label,
	.eyebrow,
	.smallcaps {
		margin: 0 0 18px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--olive);
	}

	h1,
	h2,
	h3 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	/* HERO */

	.hero {
		position: relative;
		min-height: 760px;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: var(--shell);
		margin: 0 auto;
		padding: 80px 0;
	}

	.hero-content > * {
		max-width: 720px;
	}

	.hero-content::before {
		content: '';
		position: absolute;
		top: 50%;
		left: -34px;
		width: min(760px, calc(100vw - 60px));
		height: calc(100% - 110px);
		transform: translateY(-50%);
		z-index: -1;

		background:
			linear-gradient(
				180deg,
				rgba(251, 248, 241, 0.96),
				rgba(245, 238, 226, 0.94)
			);

		border: 1px solid rgba(85, 82, 58, 0.12);
		border-radius: 10px;

		box-shadow:
			0 14px 38px rgba(53, 54, 41, 0.13),
			inset 0 1px 0 rgba(255, 255, 255, 0.8);
	}

	.hero-content::after {
		content: '';
		position: absolute;
		top: 50%;
		left: -34px;
		width: min(760px, calc(100vw - 60px));
		height: calc(100% - 110px);
		transform: translateY(-50%);
		z-index: -1;

		border-radius: 10px;

		background-image:
			radial-gradient(
				circle at 20% 30%,
				rgba(85, 82, 58, 0.035) 0 1px,
				transparent 1.3px
			),
			radial-gradient(
				circle at 70% 60%,
				rgba(185, 120, 88, 0.025) 0 1px,
				transparent 1.4px
			);

		background-size: 18px 18px, 24px 24px;
		pointer-events: none;
	}

	.hero .eyebrow {
		color: var(--terracotta);
	}

	.hero h1 {
		font-size: clamp(4.8rem, 8.7vw, 8.6rem);
		line-height: 0.86;
		margin: 0;
		color: var(--olive);
		font-style: italic;
		font-weight: 400;
	}

	.hero-copy {
		margin: 30px 0 0;
		max-width: 590px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.45rem;
		line-height: 1.55;
		color: rgba(53, 54, 41, 0.74);
	}

	.quiet-link {
		display: inline-flex;
		gap: 12px;
		align-items: center;
		margin-top: 34px;
		text-decoration: none;
		font-size: 0.73rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--olive);
		border-bottom: 1px solid rgba(85, 82, 58, 0.65);
		padding-bottom: 6px;
	}

	.quiet-link span {
		font-size: 1rem;
		transition: transform 0.2s ease;
	}

	.quiet-link:hover span {
		transform: translateX(4px);
	}

	/* ABOUT */

	.intro {
		background: var(--paper);
		padding-top: 140px;
	}

	.intro-simple {
		max-width: 900px;
	}

	.intro-copy {
		max-width: 760px;
	}

	.intro-copy h2,
	.section-heading h2,
	.maker-copy h2 {
		margin: 0 0 24px;
		font-size: clamp(3.3rem, 5.6vw, 5.6rem);
		line-height: 0.95;
		color: var(--olive);
	}

	.intro-copy p:not(.section-label):not(.script-note),
	.maker-copy p:not(.section-label):not(.soft-note) {
		color: rgba(53, 54, 41, 0.72);
		max-width: 690px;
	}

	.script-note {
		margin: 34px 0 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.8rem;
		color: var(--terracotta);
	}

	/* STUDIO */

	.studio {
		background: var(--ivory);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr 0.7fr;
		gap: 70px;
		align-items: end;
		margin-bottom: 54px;
	}

	.section-sidecopy {
		color: rgba(53, 54, 41, 0.65);
		max-width: 450px;
		margin: 0 0 7px;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.category {
		display: block;
		color: inherit;
		text-decoration: none;
		border-top: 1px solid var(--olive);
		padding-top: 16px;
	}

	.category-photo-wrap {
		height: 360px;
		overflow: hidden;
		background: #eee5d8;
	}

	.category-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.5s ease,
			filter 0.5s ease;
	}

	.category:hover .category-photo {
		transform: scale(1.025);
	}

	.category-copy {
		padding-top: 20px;
	}

	.category-copy .number {
		margin: 0 0 6px;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		color: var(--sage);
	}

	.category-copy h3 {
		margin: 0;
		font-size: 2.45rem;
		color: var(--olive);
	}

	.category-copy p {
		color: rgba(53, 54, 41, 0.68);
	}

	.category-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin-top: 10px;
		padding-bottom: 4px;

		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.15rem;
		font-style: italic;
		font-weight: 600;

		color: var(--terracotta);

		border-bottom: 1px solid transparent;

		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.category-link span {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.8rem;
		font-style: normal;
	}

	.category:hover .category-link {
		border-bottom-color: var(--terracotta);
		transform: translateX(3px);
	}

	/* MAKER */

	.maker {
		background: var(--paper);
	}

	.maker-grid {
		display: grid;
		grid-template-columns: 0.82fr 1.18fr;
		gap: 90px;
		align-items: center;
	}

	.maker-photo-wrap {
		position: relative;
		max-width: 480px;
	}

	.maker-photo {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
		filter: saturate(0.82) contrast(0.96);
	}

	.grace-signature {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.4rem;
		color: var(--olive) !important;
	}

	.mini-rule {
		width: 62px;
		height: 1px;
		background: var(--sage);
		margin: 34px 0 24px;
	}

	.soft-note {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.35rem;
		line-height: 1.45;
		color: var(--terracotta);
		max-width: 520px;
	}

	/* CLOSING */

	.closing {
		position: relative;
		overflow: hidden;

		min-height: 620px;
		padding: 120px 0;

		background: var(--ivory);
		text-align: center;
		border-top: 1px solid var(--line);
	}

	.closing::before {
		content: '';
		position: absolute;
		inset: 0;

		background-image: url('/images/flowers.png');
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;

		opacity: 1;

		pointer-events: none;
		z-index: 0;
	}

	.closing::after {
		content: '';
		position: absolute;
		inset: 0;

		background: rgba(245, 240, 230, 0.04);

		pointer-events: none;
		z-index: 1;
	}

	.closing-inner {
		position: relative;
		z-index: 2;

		min-height: 380px;
		max-width: 1050px;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.closing-pill {
		display: flex;
		align-items: center;
		justify-content: center;

		width: min(760px, 88%);
		min-height: 125px;

		padding: 25px 70px;

		background: #f8f1e5;

		border: 1px solid rgba(85, 82, 58, 0.2);
		border-radius: 999px;

		box-shadow:
			0 12px 32px rgba(53, 54, 41, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.9);
	}

	.closing-pill p {
		margin: 0;

		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(2.5rem, 4.5vw, 4rem);
		font-style: italic;
		font-weight: 500;
		line-height: 1;

		color: #4b4d38;
	}

	.closing-logo {
		width: 105px;
		height: 105px;

		margin-top: 30px;

		object-fit: cover;
		border-radius: 50%;

		opacity: 0.9;

		border: 1px solid rgba(85, 82, 58, 0.2);

		box-shadow:
			0 8px 22px rgba(53, 54, 41, 0.14);
	}

	/* TABLET */

	@media (max-width: 900px) {
		.hero {
			min-height: 650px;
		}

		.maker-grid,
		.section-heading {
			grid-template-columns: 1fr;
			gap: 50px;
		}

		.category-grid {
			grid-template-columns: 1fr;
			gap: 54px;
		}

		.category-photo-wrap {
			height: 520px;
		}

		.maker-photo-wrap {
			margin: 0 auto;
		}
	}

	/* MOBILE */

	@media (max-width: 640px) {
		:root {
			--shell: min(100% - 28px, 1180px);
		}

		.section {
			padding: 78px 0;
		}

		.intro {
			padding-top: 100px;
		}

		.hero {
			min-height: 610px;
			align-items: end;
		}

		.hero-content {
			padding: 70px 0 64px;
		}

		.hero-content::before,
		.hero-content::after {
			left: -14px;
			width: calc(100% + 28px);
			height: calc(100% - 60px);
			border-radius: 8px;
		}

		.hero h1 {
			font-size: clamp(4rem, 16vw, 5.5rem);
		}

		.hero-copy {
			font-size: 1.25rem;
		}

		.category-photo-wrap {
			height: 390px;
		}

		.closing {
			min-height: 520px;
			padding: 90px 0;
		}

		.closing-inner {
			min-height: 340px;
		}

		.closing-pill {
			width: 94%;
			min-height: 100px;
			padding: 20px 30px;
		}

		.closing-pill p {
			font-size: 2.25rem;
		}

		.closing-logo {
			width: 88px;
			height: 88px;
			margin-top: 24px;
		}
	}
</style>
