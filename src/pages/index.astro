---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-image"
					src="/images/studio-hero.jpg"
					alt="A warm handmade studio table with plants, flowers, cards, mosaic pieces, scissors and craft supplies."
				/>

				<div class="hero-wash" aria-hidden="true"></div>

				<div class="hero-content">
					<p class="eyebrow">THE THANK YOU CO.</p>

					<h1 id="hero-title">
						a little studio<br />
						of handmade things
					</h1>

					<p class="hero-copy">
						Paper, plants, mosaics, and small-batch pieces made slowly,
						thoughtfully, and with a soft spot for the little details.
					</p>

					<a class="quiet-link" href="#studio">
						wander through the studio <span>→</span>
					</a>
				</div>
			</section>

			<!-- ABOUT THE STUDIO -->
			<section class="intro section" id="about">
				<div class="shell intro-grid">
					<div class="intro-mark">
						<img
							src="/images/the-thank-you-co-logo.jpg"
							alt="The Thank You Co. — a little studio of handmade things"
						/>
					</div>

					<div class="intro-copy">
						<p class="section-label">A LITTLE ABOUT THE STUDIO</p>

						<h2>Things made to be kept, gifted, used, and loved.</h2>

						<p>
							The Thank You Co. is a small creative studio for handmade things:
							paper goods, mosaics, botanical pieces, seasonal curiosities, and
							whatever else happens to find its way onto the worktable.
						</p>

						<p>
							Everything is made in small batches with a little nostalgia, a little
							imperfection, and a lot of attention to the details that make something
							feel personal.
						</p>

						<p class="script-note">
							made slowly. given lovingly.
						</p>
					</div>
				</div>
			</section>

			<!-- FROM THE WORKTABLE -->
			<section class="studio section" id="studio">
				<div class="shell">
					<div class="section-heading">
						<div>
							<p class="section-label">FROM THE WORKTABLE</p>
							<h2>What lives here.</h2>
						</div>

						<p class="section-sidecopy">
							A rotating collection of useful things, sentimental things,
							plantish things, and little experiments that simply felt worth making.
						</p>
					</div>

					<div class="category-grid">

						<!-- PAPER GOODS -->
						<article class="category">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/papers.png"
									alt="Stacks of handmade botanical paper tied with twine."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">01</p>

								<h3>Paper goods</h3>

								<p>
									Handmade plantable thank-you card sets, botanical seed paper,
									and paper goods meant to feel as lovely in your hand as they do to give.
								</p>
							</div>
						</article>

						<!-- MOSAICS -->
						<article class="category">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/mosaics.png"
									alt="Colorful handmade mosaic trays arranged in a warm studio setting."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">02</p>

								<h3>Mosaics</h3>

								<p>
									Small decorative pieces, candle dishes, trays, and colorful
									objects with an intentionally handmade rhythm.
								</p>
							</div>
						</article>

						<!-- BOTANICAL THINGS -->
						<article class="category">
							<div class="category-photo-wrap">
								<img
									class="category-photo"
									src="/images/propies.png"
									alt="Plant propagations rooting in clear glass vessels."
									loading="lazy"
								/>
							</div>

							<div class="category-copy">
								<p class="number">03</p>

								<h3>Botanical things</h3>

								<p>
									Propagations, plant-inspired gifts, natural textures,
									and little green things for quiet corners.
								</p>
							</div>
						</article>

					</div>
				</div>
			</section>

			<!-- ABOUT GRACE -->
			<section class="maker section">
				<div class="shell maker-grid">
					<div class="maker-photo-wrap">
						<img
							class="maker-photo"
							src="/images/about-grace.PNG"
							alt="Portrait of Grace, maker behind The Thank You Co."
							loading="lazy"
						/>
					</div>

					<div class="maker-copy">
						<p class="section-label">BEHIND THE STUDIO</p>

						<h2>Hello, I’m Grace.</h2>

						<p>
							By day, I work in data science, but I’ve always needed a creative
							corner of my life — somewhere for paper scraps, plants, mosaics,
							handwritten notes, old-fashioned details, and whatever little idea
							I can’t stop thinking about.
						</p>

						<p>
							The Thank You Co. grew out of that love for making things that feel
							personal. Not perfect. Not mass-produced. Just thoughtful, useful,
							beautiful little things made slowly and with a lot of care.
						</p>

						<p>
							You’ll find a bit of everything here as the studio grows: handmade
							cards, paper goods, plant-inspired pieces, mosaics, seasonal creations,
							and probably a few experiments along the way. I like to think of it
							less as a traditional shop and more as my little studio — a place where
							I can make something simply because it delighted me, and hopefully
							pass a little of that delight on to you.
						</p>

						<p>
							I’m so glad you found your way here.
						</p>

						<p class="grace-signature">
							— Grace
						</p>

						<div class="mini-rule"></div>

						<p class="soft-note">
							There will probably be flowers on the table. There will almost certainly
							be a cat nearby.
						</p>
					</div>
				</div>
			</section>

			<!-- COLLECTION / ETSY -->
			<section class="shop section" id="shop">
				<div class="shell shop-grid">

					<div class="shop-copy">
						<p class="section-label">THE COLLECTION</p>

						<h2>See what’s on the worktable.</h2>

						<p>
							The collection changes as the studio does. Some pieces come back,
							some exist only once, and some are simply experiments that became favorites.
						</p>

						<a
							class="mosaic-collection"
							href="https://www.etsy.com/shop/TheThankYouCoStudio"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="View The Thank You Co. collection on Etsy"
						>
							<span class="mosaic-tiles mosaic-tiles-top" aria-hidden="true">
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</span>

							<span class="mosaic-tiles mosaic-tiles-bottom" aria-hidden="true">
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</span>

							<span class="mosaic-side mosaic-side-left" aria-hidden="true">
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</span>

							<span class="mosaic-side mosaic-side-right" aria-hidden="true">
								<span></span>
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</span>

							<span class="mosaic-content">
								<span class="mosaic-kicker">
									THE CURRENT COLLECTION
								</span>

								<span class="mosaic-title">
									View the collection
								</span>

								<span class="mosaic-copy">
									See the handmade pieces currently available from the studio.
								</span>

								<span class="mosaic-arrow" aria-hidden="true">
									→
								</span>
							</span>
						</a>
					</div>

					<div class="shop-note-card">
						<p class="smallcaps">SMALL BATCHES</p>

						<p class="shop-script">
							made with care,<br />
							never rushed.
						</p>

						<p class="heart-row">
							♡ &nbsp; ✿ &nbsp; ♡
						</p>
					</div>
				</div>
			</section>

			<!-- CLOSING -->
			<section class="closing">
				<div class="shell closing-inner">
					<p class="closing-kicker">
						THE THANK YOU CO.
					</p>

					<h2>
						a little studio of handmade things
					</h2>

					<p class="closing-note">
						thank you for stopping by ♡
					</p>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--ivory: #f5f0e6;
		--paper: #fbf8f1;
		--sage: #77775a;
		--olive: #55523a;
		--soft-green: #9a9b78;
		--blush: #d6ad9c;
		--terracotta: #b97858;
		--sand: #cdb99b;
		--ink: #353629;
		--line: rgba(85, 82, 58, 0.18);
		--shell: min(1180px, calc(100% - 42px));
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--ivory);
	}

	body {
		margin: 0;
		background: var(--ivory);
		color: var(--ink);
		font-family: 'Montserrat', sans-serif;
		font-size: 16px;
		line-height: 1.75;
		-webkit-font-smoothing: antialiased;
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}

	::selection {
		background: #ddd1bd;
		color: var(--ink);
	}

	.shell {
		width: var(--shell);
		margin: 0 auto;
	}

	.section {
		padding: 110px 0;
	}

	.section-label,
	.eyebrow,
	.smallcaps,
	.closing-kicker {
		margin: 0 0 18px;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--olive);
	}

	h1,
	h2,
	h3 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	/* HERO */

	.hero {
		position: relative;
		min-height: 760px;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-wash {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				rgba(247, 243, 234, 0.82) 0%,
				rgba(247, 243, 234, 0.54) 42%,
				rgba(247, 243, 234, 0.24) 100%
			),
			linear-gradient(
				180deg,
				rgba(255, 255, 255, 0.08),
				rgba(245, 240, 230, 0.28)
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: var(--shell);
		margin: 0 auto;
		padding: 80px 0;
	}

	.hero-content > * {
		max-width: 720px;
	}

	.hero h1 {
		font-size: clamp(4.8rem, 8.7vw, 8.6rem);
		line-height: 0.86;
		margin: 0;
		color: var(--olive);
		font-style: italic;
		font-weight: 400;
	}

	.hero-copy {
		margin: 30px 0 0;
		max-width: 590px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.45rem;
		line-height: 1.55;
		color: rgba(53, 54, 41, 0.78);
	}

	.quiet-link {
		display: inline-flex;
		gap: 12px;
		align-items: center;
		margin-top: 34px;
		text-decoration: none;
		font-size: 0.73rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--olive);
		padding-bottom: 6px;
	}

	.quiet-link span {
		font-size: 1rem;
		transition: transform 0.2s ease;
	}

	.quiet-link:hover span {
		transform: translateX(4px);
	}

	/* INTRO */

	.intro {
		background: var(--paper);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 90px;
		align-items: center;
	}

	.intro-mark {
		max-width: 480px;
		justify-self: center;
	}

	.intro-mark img {
		width: 100%;
		border-radius: 50%;
		box-shadow: 0 24px 70px rgba(82, 72, 48, 0.08);
	}

	.intro-copy h2,
	.section-heading h2,
	.maker-copy h2,
	.shop-copy h2 {
		margin: 0 0 24px;
		font-size: clamp(3.3rem, 5.6vw, 5.6rem);
		line-height: 0.95;
		color: var(--olive);
	}

	.intro-copy p:not(.section-label):not(.script-note),
	.maker-copy p:not(.section-label):not(.soft-note),
	.shop-copy p:not(.section-label) {
		color: rgba(53, 54, 41, 0.72);
		max-width: 690px;
	}

	.script-note {
		margin: 34px 0 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.8rem;
		color: var(--terracotta);
	}

	/* STUDIO */

	.studio {
		background: var(--ivory);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr 0.7fr;
		gap: 70px;
		align-items: end;
		margin-bottom: 54px;
	}

	.section-sidecopy {
		color: rgba(53, 54, 41, 0.65);
		max-width: 450px;
		margin: 0 0 7px;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.category {
		border-top: 1px solid var(--olive);
		padding-top: 16px;
	}

	.category-photo-wrap {
		height: 360px;
		overflow: hidden;
		background: #eee5d8;
	}

	.category-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.5s ease,
			filter 0.5s ease;
	}

	.category:hover .category-photo {
		transform: scale(1.025);
	}

	.category-copy {
		padding-top: 20px;
	}

	.category-copy .number {
		margin: 0 0 6px;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		color: var(--sage);
	}

	.category-copy h3 {
		margin: 0;
		font-size: 2.45rem;
		color: var(--olive);
	}

	.category-copy p:last-child {
		color: rgba(53, 54, 41, 0.68);
		margin-bottom: 0;
	}

	/* MAKER */

	.maker {
		background: var(--paper);
	}

	.maker-grid {
		display: grid;
		grid-template-columns: 0.82fr 1.18fr;
		gap: 90px;
		align-items: center;
	}

	.maker-photo-wrap {
		position: relative;
		max-width: 480px;
	}

	.maker-photo {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
		filter: saturate(0.82) contrast(0.96);
	}

	.grace-signature {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.4rem;
		color: var(--olive) !important;
	}

	.mini-rule {
		width: 62px;
		height: 1px;
		background: var(--sage);
		margin: 34px 0 24px;
	}

	.soft-note {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1.35rem;
		line-height: 1.45;
		color: var(--terracotta);
		max-width: 520px;
	}

	/* SHOP / COLLECTION */

	.shop {
		background: #e2d9c8;
		overflow: hidden;
	}

	.shop-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 90px;
		align-items: center;
	}

	/*
	 * GLASS MOSAIC COLLECTION CTA
	 */

	.mosaic-collection {
		position: relative;
		display: block;
		width: min(100%, 590px);
		margin-top: 36px;
		padding: 19px;
		border-radius: 30px;
		text-decoration: none;
		overflow: hidden;
		background:
			linear-gradient(
				145deg,
				#d2b692 0%,
				#ead7bd 45%,
				#c4a27b 100%
			);
		box-shadow:
			0 17px 45px rgba(66, 53, 37, 0.13),
			inset 0 1px 0 rgba(255, 255, 255, 0.55);

		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}

	.mosaic-collection:hover {
		transform: translateY(-5px);
		box-shadow:
			0 25px 60px rgba(66, 53, 37, 0.19),
			inset 0 1px 0 rgba(255, 255, 255, 0.58);
	}

	.mosaic-content {
		position: relative;
		z-index: 5;
		display: block;
		min-height: 255px;
		padding: 52px 50px 45px;
		border-radius: 21px;
		text-align: center;

		background:
			radial-gradient(
				circle at 25% 20%,
				rgba(255, 255, 255, 0.94),
				transparent 24%
			),
			linear-gradient(
				160deg,
				#fffaf0,
				#f7eddc
			);

		box-shadow:
			inset 0 0 0 1px rgba(88, 68, 45, 0.12),
			inset 0 7px 20px rgba(255, 255, 255, 0.42);
	}

	.mosaic-kicker {
		display: block;
		margin-bottom: 12px;
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--terracotta);
	}

	.mosaic-title {
		display: block;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(2.75rem, 4.3vw, 4rem);
		font-weight: 400;
		font-style: italic;
		line-height: 0.95;
		color: var(--olive);
	}

	.mosaic-copy {
		display: block;
		max-width: 380px;
		margin: 17px auto 0;
		font-size: 0.82rem;
		line-height: 1.65;
		color: rgba(53, 54, 41, 0.6);
	}

	.mosaic-arrow {
		display: inline-block;
		margin-top: 16px;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.7rem;
		color: var(--olive);
		transition: transform 0.25s ease;
	}

	.mosaic-collection:hover .mosaic-arrow {
		transform: translateX(7px);
	}

	/*
	 * TOP + BOTTOM GLASS TILES
	 */

	.mosaic-tiles {
		position: absolute;
		z-index: 8;
		left: 21px;
		right: 21px;
		height: 18px;
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 5px;
		pointer-events: none;
	}

	.mosaic-tiles-top {
		top: 10px;
	}

	.mosaic-tiles-bottom {
		bottom: 10px;
	}

	.mosaic-tiles span,
	.mosaic-side span {
		position: relative;
		display: block;
		border-radius: 4px;
		overflow: hidden;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.7),
				rgba(255, 255, 255, 0.12) 45%,
				rgba(0, 0, 0, 0.06)
			),
			var(--tile);

		box-shadow:
			inset 1px 1px 2px rgba(255, 255, 255, 0.65),
			inset -1px -1px 2px rgba(52, 42, 31, 0.12),
			0 1px 2px rgba(52, 42, 31, 0.16);
	}

	.mosaic-tiles span::after,
	.mosaic-side span::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 3px;
		right: 3px;
		height: 30%;
		border-radius: inherit;
		background: rgba(255, 255, 255, 0.28);
		filter: blur(1px);
	}

	.mosaic-tiles span:nth-child(1) {
		--tile: #4b817c;
	}

	.mosaic-tiles span:nth-child(2) {
		--tile: #d79074;
	}

	.mosaic-tiles span:nth-child(3) {
		--tile: #a7a574;
	}

	.mosaic-tiles span:nth-child(4) {
		--tile: #d6a9a3;
	}

	.mosaic-tiles span:nth-child(5) {
		--tile: #c17c55;
	}

	.mosaic-tiles span:nth-child(6) {
		--tile: #708a69;
	}

	.mosaic-tiles span:nth-child(7) {
		--tile: #efc38e;
	}

