---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title =
	'Plantable Thank You Cards & Handmade Paper Goods | The Thank You Co.';

const description =
	'Explore handmade plantable thank-you cards, botanical seed paper, greeting cards, and small-batch paper goods from The Thank You Co.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<section class="page-hero">
				<div class="shell">
					<p class="eyebrow">HANDMADE PAPER GOODS</p>

					<h1>Paper meant to be held onto a little longer.</h1>

					<p class="intro">
						Explore handmade plantable thank-you cards, botanical seed paper,
						greeting cards, and small-batch paper goods made slowly in
						The Thank You Co. studio.
					</p>

					<a
						class="shop-link"
						href="https://www.etsy.com/shop/TheThankYouCoStudio"
						target="_blank"
						rel="noopener noreferrer"
					>
						shop the paper collection →
					</a>
				</div>
			</section>

			<section class="page-content">
				<div class="shell grid">
					<div>
						<img
							src="/images/papers.png"
							alt="Handmade plantable thank-you cards and botanical seed paper from The Thank You Co."
						/>
					</div>

					<div class="copy">
						<p class="eyebrow">FROM THE WORKTABLE</p>

						<h2>Handmade paper goods with a botanical touch</h2>

						<p>
							Each paper piece is made with attention to texture, softness,
							and the little details that make a note feel personal.
						</p>

						<p>
							The collection includes plantable thank-you cards, handmade
							greeting cards, botanical seed paper, and small-batch paper goods
							designed for thoughtful gifting and everyday correspondence.
						</p>

						<p>
							Many pieces are made in small batches, so the paper, texture,
							and finish may vary slightly from one piece to the next.
						</p>
					</div>
				</div>
			</section>

			<section class="details">
				<div class="shell">
					<h2>Made for thoughtful notes and little moments</h2>

					<div class="detail-grid">
						<article>
							<h3>Plantable thank-you cards</h3>
							<p>
								Handmade cards designed to carry a heartfelt message and,
								depending on the paper, be planted afterward.
							</p>
						</article>

						<article>
							<h3>Botanical seed paper</h3>
							<p>
								Textured handmade paper with a botanical feel, perfect for
								notes, gifts, and creative projects.
							</p>
						</article>

						<article>
							<h3>Handmade greeting cards</h3>
							<p>
								Small-batch cards made for birthdays, thank-yous, celebrations,
								and the moments that deserve something more personal.
							</p>
						</article>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--ivory: #f5f0e6;
		--paper: #fbf8f1;
		--olive: #55523a;
		--terracotta: #b97858;
		--ink: #353629;
		--shell: min(1180px, calc(100% - 42px));
	}

	body {
		margin: 0;
		background: var(--ivory);
		color: var(--ink);
		font-family: 'Montserrat', sans-serif;
	}

	.shell {
		width: var(--shell);
		margin: 0 auto;
	}

	.page-hero {
		padding: 140px 0 110px;
		background: var(--paper);
	}

	.eyebrow {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--terracotta);
	}

	h1,
	h2,
	h3 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		color: var(--olive);
	}

	h1 {
		max-width: 900px;
		font-size: clamp(4rem, 7vw, 7rem);
		line-height: 0.92;
		font-weight: 400;
		margin: 18px 0 26px;
	}

	.intro {
		max-width: 720px;
		font-size: 1.2rem;
		line-height: 1.8;
	}

	.shop-link {
		display: inline-block;
		margin-top: 28px;
		color: var(--olive);
		text-decoration: none;
		border-bottom: 1px solid var(--olive);
		padding-bottom: 5px;
	}

	.page-content {
		padding: 110px 0;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;
	}

	.grid img {
		width: 100%;
		display: block;
	}

	.copy h2,
	.details h2 {
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: 1;
		font-weight: 400;
		margin: 12px 0 24px;
	}

	.copy p,
	.detail-grid p {
		line-height: 1.8;
		color: rgba(53, 54, 41, 0.72);
	}

	.details {
		padding: 100px 0;
		background: var(--paper);
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 36px;
		margin-top: 48px;
	}

	.detail-grid h3 {
		font-size: 2rem;
		margin-bottom: 12px;
	}

	@media (max-width: 800px) {
		.grid,
		.detail-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
