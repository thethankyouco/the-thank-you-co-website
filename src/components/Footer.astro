---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-shell">
		<div class="footer-top">
			<div class="footer-brand">
				<p class="footer-name">THE THANK YOU CO.</p>
				<p class="footer-tagline">a little studio of handmade things</p>

				<div class="social-area">
					<p class="social-label">FOLLOW ALONG</p>

					<div class="social-links">
						<a
							href="https://www.facebook.com/TheThankYouCoStudio"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="The Thank You Co. on Facebook"
						>
							Facebook
						</a>

						<a
							href="https://www.instagram.com/thethankyoucostudio"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="The Thank You Co. on Instagram"
						>
							Instagram
						</a>

						<a
							href="https://www.pinterest.com/TheThankYouCoStudio"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="The Thank You Co. on Pinterest"
						>
							Pinterest
						</a>
					</div>
				</div>
			</div>

			<nav class="footer-links" aria-label="Footer navigation">
				<a href="/">Home</a>
				<a href="/#studio">Studio</a>
				<a href="/#about">About</a>
				<a href="/#shop">Shop</a>
				<a href="mailto:hello@thethankyouco.com">Email</a>
			</nav>
		</div>

		<div class="footer-bottom">
			<p>© {today.getFullYear()} The Thank You Co.</p>
			<p class="footer-heart">♡</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: #55523a;
		color: #f5f0e6;
		padding: 58px 22px 28px;
	}

	.footer-shell {
		max-width: 1180px;
		margin: 0 auto;
	}

	.footer-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 50px;
		padding-bottom: 38px;
	}

	.footer-brand {
		max-width: 520px;
	}

	.footer-name {
		margin: 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: .24em;
	}

	.footer-tagline {
		margin: 8px 0 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-style: italic;
		font-size: 1rem;
		letter-spacing: .06em;
		color: rgba(245, 240, 230, .68);
	}

	.social-area {
		margin-top: 28px;
	}

	.social-label {
		margin: 0 0 10px;
		font-family: 'Montserrat', sans-serif;
		font-size: .62rem;
		font-weight: 600;
		letter-spacing: .22em;
		text-transform: uppercase;
		color: rgba(245, 240, 230, .62);
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
	}

	.social-links a {
		color: rgba(245, 240, 230, .82);
		text-decoration: none;
		font-family: 'Montserrat', sans-serif;
		font-size: .67rem;
		font-weight: 600;
		letter-spacing: .14em;
		text-transform: uppercase;
		border-bottom: 1px solid transparent;
		padding-bottom: 3px;
		transition:
			color .2s ease,
			border-color .2s ease;
	}

	.social-links a:hover {
		color: #fffaf1;
		border-color: #d6ad9c;
	}

	.footer-links {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
	}

	.footer-links a {
		color: rgba(245, 240, 230, .78);
		text-decoration: none;
		font-family: 'Montserrat', sans-serif;
		font-size: .66rem;
		text-transform: uppercase;
		letter-spacing: .17em;
	}

	.footer-links a:hover {
		color: #fffaf1;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid rgba(245, 240, 230, .16);
		padding-top: 22px;
		font-size: .72rem;
		letter-spacing: .06em;
		color: rgba(245, 240, 230, .55);
	}

	.footer-bottom p {
		margin: 0;
	}

	.footer-heart {
		font-family: Georgia, serif;
		font-size: 1.15rem;
		color: #d6ad9c;
	}

	@media (max-width: 700px) {
		.footer-top {
			flex-direction: column;
		}

		.footer-links {
			gap: 16px;
		}

		.social-links {
			gap: 14px;
		}

		.footer-bottom {
			margin-top: 6px;
		}
	}
</style>
