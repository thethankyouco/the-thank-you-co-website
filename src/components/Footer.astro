---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<p class="name">THE THANK YOU CO.</p>
			<p class="tagline">a little studio of handmade things</p>
		</div>

		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/#about">About</a>
			<a href="/#shop">Shop</a>
			<a href="mailto:hello@thethankyouco.com">Email</a>
		</div>

		<div class="footer-bottom">
			<p>© {today.getFullYear()} The Thank You Co.</p>
			<p class="heart">♡</p>
		</div>
	</div>
</footer>

<style>
	footer {
		background: #25312f;
		color: #f7f0e5;
		padding: 4rem 1.5rem 2rem;
	}

	.footer-inner {
		max-width: 1180px;
		margin: 0 auto;
	}

	.footer-brand {
		text-align: center;
		margin-bottom: 2rem;
	}

	.name {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.2em;
	}

	.tagline {
		margin: 0.5rem 0 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-style: italic;
		color: rgba(247, 240, 229, 0.7);
	}

	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.footer-links a {
		color: #f7f0e5;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75rem;
	}

	.footer-links a:hover {
		color: #f0ce5b;
	}

	.footer-bottom {
		border-top: 1px solid rgba(247, 240, 229, 0.16);
		padding-top: 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		color: rgba(247, 240, 229, 0.6);
		font-size: 0.78rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	.heart {
		color: #ff918a;
		font-size: 1.25rem;
	}

	@media (max-width: 600px) {
		.footer-bottom {
			flex-direction: column;
			justify-content: center;
			text-align: center;
		}
	}
</style>
