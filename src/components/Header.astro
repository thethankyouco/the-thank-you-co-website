---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="nav-wrap">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-main">{SITE_TITLE}</span>
			<span class="brand-sub">a little studio of handmade things</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#about">About</HeaderLink>
			<HeaderLink href="/#shop">Shop</HeaderLink>
			<a href="mailto:hello@thethankyouco.com">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(247, 240, 229, 0.94);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(37, 49, 47, 0.1);
	}

	.nav-wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: #25312f;
		line-height: 1.1;
	}

	.brand-main {
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.22em;
	}

	.brand-sub {
		margin-top: 0.35rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-style: italic;
		font-size: 0.78rem;
		color: rgba(37, 49, 47, 0.68);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.internal-links :global(a),
	.internal-links a {
		padding: 0.5rem 0;
		color: #25312f;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75rem;
		font-weight: 600;
		border-bottom: 1px solid transparent;
	}

	.internal-links :global(a:hover),
	.internal-links a:hover {
		border-bottom-color: #f25a3d;
	}

	@media (max-width: 720px) {
		.nav-wrap {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}

		.internal-links {
			width: 100%;
			gap: 1rem;
			flex-wrap: wrap;
		}
	}
</style>
